from abc import ABC, abstractmethod

class Gastos(ABC):
    def __init__(self, descricao, valor, categoria, data):
        self.des = descricao
        self.v = valor
        self.c = categoria
        self.dat = data

    def lista(self):
        return {
            'descrição': self.des,
            'valor': self.v,
            'categoria': self.c,
            'data': self.dat
        }

    @abstractmethod
    def adicionar(self, gastos):
        pass

class Tipo(Gastos):
    def adicionar(self, gastos):
       gastos.append(self)

class GerenciaGastos:
    def __init__(self):
        self.gastos = []

    def adicionar(self, gastos):
        self.gastos.append(gastos)

    def mostrar(self):
        if not self.gastos:
            print('Nenhum gasto encontrado')
            return

        print('\nGastos gerais:')
        for gasto in self.gastos:
            print(gasto.lista())

    def porCategoria(self, categoria):
        encontrados = [
            gasto for gasto in self.gastos
            if gasto.categoria.lower() == categoria.lower()
        ]
        if not encontrados:
            print('Nenhum gasto dessa categoria')
            return

        for gasto in encontrados:
            print(gasto.lista())

    def gastosMensais(self, mes):
        encontrados = []
        for gasto in self.gastos:
            partes = gasto.data.split('/')

        if len(partes) == 3:
            mes_gasto = partes[1]

            if mes_gasto == mes:
                encontrados.append(gasto)

        if not encontrados:
            print("Nenhum gasto encontrado nesse mês.")
            return

        total = 0

        for gasto in encontrados:
            print(gasto.lista())
            total += gasto.valor

        print(f"Total do mês: R$ {total:.2f}")

    def maior_gasto(self):
        if not self.gastos:
            print("Nenhum gasto cadastrado.")
            return

        maior = max(self.gastos, key=lambda gasto: gasto.valor)

        print("\nMaior gasto:")
        print(maior.lista())

    def salvar(self):
        with open("gastos.txt", "w", encoding="utf-8") as arquivo:
            for gasto in self.gastos:
                arquivo.write(
                f"{gasto.descricao};"
                f"{gasto.valor};"
                f"{gasto.categoria};"
                f"{gasto.data}\n"
            )

        print("Dados salvos com sucesso!")

gerenciador = GerenciaGastos()

while True:
    try:
        escolha = int(input(
            "\n[1] para adicionar um gasto\n"
            "[2] para ver seus gastos gerais\n"
            "[3] escolher gastos por categoria\n"
            "[4] gastos mensais\n"
            "[5] maior gasto\n"
            "[6] salvar dados\n"
            "[0] para fechar: "
        ))
    except ValueError:
        print("Digite uma opção válida.")
        continue

    if escolha == 1:
        descricao = input("Descrição do gasto: ")

        try:
            valor = float(input("Valor do gasto: "))
        except ValueError:
            print("Digite um valor válido.")
            continue

        categoria = input("Categoria do gasto: ")
        data = input("Data do gasto (DD/MM/AAAA): ")

        gasto = Tipo(descricao, valor, categoria, data)

        gerenciador.adicionar(gasto)

        print("Gasto adicionado!")

    elif escolha == 2:
        gerenciador.mostrar()

    elif escolha == 3:
        categoria = input("Digite a categoria: ")
        gerenciador.porCategoria(categoria)

    elif escolha == 4:
        mes = input("Digite o número do mês (ex: 09): ")
        gerenciador.gastosMensais(mes)

    elif escolha == 5:
        gerenciador.maior_gasto()

    elif escolha == 6:
        gerenciador.salvar()

    elif escolha == 0:
        print("Programa encerrado.")
        break

    else:
        print("Opção inválida.")
